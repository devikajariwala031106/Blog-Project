<div class="error-page">
  <div>
    <div class="error-code">500</div>
    <h1 class="error-title">Server Error</h1>
    <p class="error-message">Something went wrong on our end. Our team has been notified and is working on it.</p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a href="/dashboard" class="btn-primary-custom">
        <i class="fa-solid fa-house"></i> Back to Dashboard
      </a>
      <button onclick="location.reload()" class="btn-secondary-custom">
        <i class="fa-solid fa-rotate-right"></i> Try Again
      </button>
    </div>
    <div style="margin-top:40px;opacity:0.15;">
      <i class="fa-solid fa-triangle-exclamation" style="font-size:100px;color:var(--danger);"></i>
    </div>
  </div>
</div>
