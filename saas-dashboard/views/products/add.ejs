<%- include('../partials/breadcrumb', { breadcrumbs: [{ label: 'Products', url: '/products' }, { label: 'Add Product', url: '#' }] }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">
      <i class="fa-solid fa-box" style="color:var(--accent);margin-right:10px;"></i>Add Product
    </h1>
    <p class="page-subtitle">Create a new product and add it to your catalog</p>
  </div>
  <a href="/products" class="btn-secondary-custom"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div class="form-section" style="max-width:900px;">
  <div class="form-card">
    <form action="/products/add" method="POST" enctype="multipart/form-data">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
        <div>
          <div style="font-size:13px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.7px;margin-bottom:18px;padding-bottom:12px;border-bottom:1px solid var(--glass-border);">
            <i class="fa-solid fa-box" style="color:var(--accent);margin-right:8px;"></i>Product Info
          </div>

          <div class="form-group">
            <label class="form-label-custom" for="name">
              <i class="fa-solid fa-tag" style="margin-right:6px;"></i>Product Name
            </label>
            <input type="text" id="name" name="name" class="form-control-custom" placeholder="Product name" required>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label-custom" for="price">
                <i class="fa-solid fa-dollar-sign" style="margin-right:6px;"></i>Price (USD)
              </label>
              <input type="number" id="price" name="price" class="form-control-custom" placeholder="0.00" min="0" step="0.01" required>
            </div>
            <div class="form-group">
              <label class="form-label-custom" for="stock">
                <i class="fa-solid fa-warehouse" style="margin-right:6px;"></i>Stock Qty
              </label>
              <input type="number" id="stock" name="stock" class="form-control-custom" placeholder="0" min="0" value="0">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label-custom" for="category">
                <i class="fa-solid fa-layer-group" style="margin-right:6px;"></i>Category
              </label>
              <select id="category" name="category" class="form-control-custom" required>
                <option value="">Select category</option>
                <% categories.forEach(cat => { %>
                <option value="<%= cat._id %>"><%= cat.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label-custom" for="sku">
                <i class="fa-solid fa-barcode" style="margin-right:6px;"></i>SKU
              </label>
              <input type="text" id="sku" name="sku" class="form-control-custom" placeholder="SKU-001">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label-custom" for="status">
              <i class="fa-solid fa-circle-half-stroke" style="margin-right:6px;"></i>Status
            </label>
            <select id="status" name="status" class="form-control-custom">
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
              <option value="out_of_stock">Out of Stock</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label-custom" for="description">
              <i class="fa-solid fa-align-left" style="margin-right:6px;"></i>Description
            </label>
            <textarea id="description" name="description" class="form-control-custom" rows="4" placeholder="Product description..."></textarea>
          </div>
        </div>

        <div>
          <div style="font-size:13px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.7px;margin-bottom:18px;padding-bottom:12px;border-bottom:1px solid var(--glass-border);">
            <i class="fa-solid fa-image" style="color:var(--info);margin-right:8px;"></i>Product Image
          </div>

          <div class="image-upload-area" id="uploadArea">
            <div class="image-upload-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
            <div class="image-upload-text">
              Drag and drop or <span>browse files</span>
            </div>
            <div style="font-size:11px;color:var(--text-muted);margin-top:8px;">
              PNG, JPG, WebP up to 5MB
            </div>
          </div>

          <input type="file" id="imageInput" name="image" accept="image/*" style="display:none;">

          <div class="image-preview-box" id="imagePreviewBox">
            <img id="imagePreview" src="" class="image-preview" alt="Preview">
            <div>
              <div style="font-size:13px;font-weight:600;color:var(--text-primary);">Image selected</div>
              <div style="font-size:12px;color:var(--text-muted);">Click the area to change</div>
            </div>
          </div>

          <div style="margin-top:20px;background:rgba(99,102,241,0.06);border:1px solid rgba(99,102,241,0.15);border-radius:10px;padding:14px 16px;">
            <div style="font-size:12px;font-weight:600;color:var(--accent-light);margin-bottom:8px;">
              <i class="fa-solid fa-circle-info" style="margin-right:6px;"></i>Image Guidelines
            </div>
            <ul style="font-size:12px;color:var(--text-muted);list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:5px;">
              <li><i class="fa-solid fa-check" style="color:var(--success);margin-right:6px;font-size:10px;"></i>Use square images for best results</li>
              <li><i class="fa-solid fa-check" style="color:var(--success);margin-right:6px;font-size:10px;"></i>Recommended size: 800 x 800px</li>
              <li><i class="fa-solid fa-check" style="color:var(--success);margin-right:6px;font-size:10px;"></i>Max file size: 5MB</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="form-divider"></div>

      <div class="form-actions">
        <button type="submit" class="btn-primary-custom"><i class="fa-solid fa-plus"></i> Create Product</button>
        <a href="/products" class="btn-secondary-custom"><i class="fa-solid fa-xmark"></i> Cancel</a>
      </div>
    </form>
  </div>
</div>
