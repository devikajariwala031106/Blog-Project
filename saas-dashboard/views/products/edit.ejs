<%- include('../partials/breadcrumb', { breadcrumbs: [{ label: 'Products', url: '/products' }, { label: 'Edit Product', url: '#' }] }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">
      <i class="fa-solid fa-pen-to-square" style="color:var(--accent);margin-right:10px;"></i>Edit Product
    </h1>
    <p class="page-subtitle">Update details for <strong style="color:var(--accent-light);"><%= product.name %></strong></p>
  </div>
  <a href="/products" class="btn-secondary-custom"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div class="form-section" style="max-width:900px;">
  <div class="form-card">
    <form action="/products/<%= product._id %>/edit" method="POST" enctype="multipart/form-data">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
        <div>
          <div style="font-size:13px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.7px;margin-bottom:18px;padding-bottom:12px;border-bottom:1px solid var(--glass-border);">
            <i class="fa-solid fa-box" style="color:var(--accent);margin-right:8px;"></i>Product Info
          </div>

          <div class="form-group">
            <label class="form-label-custom" for="name">
              <i class="fa-solid fa-tag" style="margin-right:6px;"></i>Product Name
            </label>
            <input type="text" id="name" name="name" class="form-control-custom" value="<%= product.name %>" required>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label-custom" for="price">
                <i class="fa-solid fa-dollar-sign" style="margin-right:6px;"></i>Price (USD)
              </label>
              <input type="number" id="price" name="price" class="form-control-custom" value="<%= product.price %>" min="0" step="0.01" required>
            </div>
            <div class="form-group">
              <label class="form-label-custom" for="stock">
                <i class="fa-solid fa-warehouse" style="margin-right:6px;"></i>Stock Qty
              </label>
              <input type="number" id="stock" name="stock" class="form-control-custom" value="<%= product.stock %>" min="0">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label-custom" for="category">
                <i class="fa-solid fa-layer-group" style="margin-right:6px;"></i>Category
              </label>
              <select id="category" name="category" class="form-control-custom" required>
                <option value="">Select category</option>
                <% categories.forEach(cat => { %>
                <option value="<%= cat._id %>" <%= product.category && product.category._id.toString() === cat._id.toString() ? 'selected' : '' %>>
                  <%= cat.name %>
                </option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label-custom" for="sku">
                <i class="fa-solid fa-barcode" style="margin-right:6px;"></i>SKU
              </label>
              <input type="text" id="sku" name="sku" class="form-control-custom" value="<%= product.sku || '' %>">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label-custom" for="status">
              <i class="fa-solid fa-circle-half-stroke" style="margin-right:6px;"></i>Status
            </label>
            <select id="status" name="status" class="form-control-custom">
              <option value="active" <%= product.status === 'active' ? 'selected' : '' %>>Active</option>
              <option value="inactive" <%= product.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
              <option value="out_of_stock" <%= product.status === 'out_of_stock' ? 'selected' : '' %>>Out of Stock</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label-custom" for="description">
              <i class="fa-solid fa-align-left" style="margin-right:6px;"></i>Description
            </label>
            <textarea id="description" name="description" class="form-control-custom" rows="4"><%= product.description || '' %></textarea>
          </div>
        </div>

        <div>
          <div style="font-size:13px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.7px;margin-bottom:18px;padding-bottom:12px;border-bottom:1px solid var(--glass-border);">
            <i class="fa-solid fa-image" style="color:var(--info);margin-right:8px;"></i>Product Image
          </div>

          <% if (product.image) { %>
          <div style="margin-bottom:16px;text-align:center;">
            <img src="/uploads/<%= product.image %>" style="width:120px;height:120px;border-radius:14px;object-fit:cover;border:2px solid var(--glass-border);box-shadow:var(--shadow);" alt="Current image">
            <div style="font-size:12px;color:var(--text-muted);margin-top:8px;">
              <i class="fa-solid fa-image" style="margin-right:4px;color:var(--accent);"></i>Current image
            </div>
          </div>
          <% } %>

          <div class="image-upload-area" id="uploadArea">
            <div class="image-upload-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
            <div class="image-upload-text">
              <%= product.image ? 'Click to replace image' : 'Drag and drop or' %> <span>browse files</span>
            </div>
            <div style="font-size:11px;color:var(--text-muted);margin-top:8px;">PNG, JPG, WebP up to 5MB</div>
          </div>

          <input type="file" id="imageInput" name="image" accept="image/*" style="display:none;">

          <div class="image-preview-box" id="imagePreviewBox">
            <img id="imagePreview" src="" class="image-preview" alt="Preview">
            <div>
              <div style="font-size:13px;font-weight:600;color:var(--text-primary);">New image selected</div>
              <div style="font-size:12px;color:var(--text-muted);">Will replace current image</div>
            </div>
          </div>
        </div>
      </div>

      <div class="form-divider"></div>

      <div class="form-actions">
        <button type="submit" class="btn-primary-custom"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
        <a href="/products" class="btn-secondary-custom"><i class="fa-solid fa-xmark"></i> Cancel</a>
        <button type="button" class="btn-danger-custom ms-auto"
          data-delete-url="/products/<%= product._id %>?_method=DELETE"
          data-delete-name="<%= product.name %>">
          <i class="fa-solid fa-trash"></i> Delete Product
        </button>
      </div>
    </form>
  </div>
</div>
