<%- include('../partials/breadcrumb', { breadcrumbs: [{ label: 'Users', url: '/users' }, { label: 'Add User', url: '#' }] }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">
      <i class="fa-solid fa-user-plus" style="color:var(--accent);margin-right:10px;"></i>Add New User
    </h1>
    <p class="page-subtitle">Create a new user account with role and permissions</p>
  </div>
  <a href="/users" class="btn-secondary-custom">
    <i class="fa-solid fa-arrow-left"></i> Back to Users
  </a>
</div>

<div class="form-section">
  <div class="form-card">
    <form action="/users/add" method="POST" id="addUserForm">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:28px;padding-bottom:20px;border-bottom:1px solid var(--glass-border);">
        <div style="width:48px;height:48px;background:rgba(99,102,241,0.15);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--accent);">
          <i class="fa-solid fa-user-plus"></i>
        </div>
        <div>
          <div style="font-size:15px;font-weight:700;color:var(--text-primary);">User Information</div>
          <div style="font-size:13px;color:var(--text-muted);">Fill in the details to create a new account</div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label-custom" for="name">
            <i class="fa-solid fa-id-card" style="margin-right:6px;"></i>Full Name
          </label>
          <input type="text" id="name" name="name" class="form-control-custom" placeholder="John Doe" required minlength="2">
        </div>
        <div class="form-group">
          <label class="form-label-custom" for="email">
            <i class="fa-regular fa-envelope" style="margin-right:6px;"></i>Email Address
          </label>
          <input type="email" id="email" name="email" class="form-control-custom" placeholder="john@example.com" required>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label-custom" for="password">
            <i class="fa-solid fa-lock" style="margin-right:6px;"></i>Password
          </label>
          <div style="position:relative;">
            <input type="password" id="password" name="password" class="form-control-custom" placeholder="Min. 6 characters" required minlength="6">
            <i class="fa-regular fa-eye toggle-password" style="cursor:pointer;position:absolute;right:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);"></i>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label-custom" for="phone">
            <i class="fa-solid fa-phone" style="margin-right:6px;"></i>Phone Number
          </label>
          <input type="tel" id="phone" name="phone" class="form-control-custom" placeholder="+1 (555) 000-0000">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label-custom" for="role">
            <i class="fa-solid fa-shield-halved" style="margin-right:6px;"></i>User Role
          </label>
          <select id="role" name="role" class="form-control-custom">
            <option value="user">User</option>
            <option value="manager">Manager</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label-custom" for="status">
            <i class="fa-solid fa-circle-half-stroke" style="margin-right:6px;"></i>Account Status
          </label>
          <select id="status" name="status" class="form-control-custom">
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
        </div>
      </div>

      <div class="form-divider"></div>

      <div class="form-actions">
        <button type="submit" class="btn-primary-custom">
          <i class="fa-solid fa-user-plus"></i> Create User
        </button>
        <a href="/users" class="btn-secondary-custom">
          <i class="fa-solid fa-xmark"></i> Cancel
        </a>
      </div>
    </form>
  </div>
</div>
