<header class="top-navbar">
  <button class="sidebar-toggle-btn" id="sidebarToggle" aria-label="Toggle sidebar">
    <i class="fa-solid fa-bars"></i>
  </button>

  <div class="navbar-search">
    <div class="search-input-wrapper">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" class="search-input" placeholder="Search anything..." id="globalSearch">
    </div>
  </div>

  <div class="navbar-actions">
    <div class="dropdown">
      <button class="nav-action-btn" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
        <i class="fa-regular fa-bell"></i>
        <span class="notification-dot"></span>
      </button>
      <div class="dropdown-menu dropdown-menu-end notification-dropdown p-2">
        <div style="padding:10px 12px;border-bottom:1px solid var(--glass-border);margin-bottom:6px;">
          <span style="font-size:14px;font-weight:700;color:var(--text-primary);">Notifications</span>
          <span style="font-size:11px;color:var(--accent-light);float:right;margin-top:2px;">3 new</span>
        </div>
        <div class="notification-item">
          <div class="notification-icon" style="background:rgba(99,102,241,0.15);color:var(--accent);">
            <i class="fa-solid fa-user-plus"></i>
          </div>
          <div class="notification-content">
            <div class="notification-text"><strong>New user registered</strong> to the platform</div>
            <div class="notification-time"><i class="fa-regular fa-clock"></i> 2 min ago</div>
          </div>
        </div>
        <div class="notification-item">
          <div class="notification-icon" style="background:rgba(16,185,129,0.15);color:var(--success);">
            <i class="fa-solid fa-box"></i>
          </div>
          <div class="notification-content">
            <div class="notification-text"><strong>Product stock</strong> running low</div>
            <div class="notification-time"><i class="fa-regular fa-clock"></i> 1 hr ago</div>
          </div>
        </div>
        <div class="notification-item">
          <div class="notification-icon" style="background:rgba(245,158,11,0.15);color:var(--warning);">
            <i class="fa-solid fa-triangle-exclamation"></i>
          </div>
          <div class="notification-content">
            <div class="notification-text"><strong>System update</strong> available</div>
            <div class="notification-time"><i class="fa-regular fa-clock"></i> 3 hrs ago</div>
          </div>
        </div>
        <div style="padding:8px 12px;text-align:center;border-top:1px solid var(--glass-border);margin-top:4px;">
          <a href="#" style="font-size:12px;color:var(--accent-light);">View all notifications</a>
        </div>
      </div>
    </div>

    <div class="navbar-divider"></div>

    <div class="dropdown">
      <div class="navbar-user" data-bs-toggle="dropdown" aria-expanded="false" role="button">
        <div class="navbar-avatar">
          <% if (currentUser && currentUser.avatar) { %>
            <img src="/uploads/<%= currentUser.avatar %>" alt="avatar">
          <% } else if (currentUser) { %>
            <%= currentUser.name.charAt(0).toUpperCase() %>
          <% } %>
        </div>
        <div class="navbar-user-info">
          <span class="navbar-user-name"><%= currentUser ? currentUser.name : 'User' %></span>
          <span class="navbar-user-role"><%= currentUser ? currentUser.role : '' %></span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size:10px;color:var(--text-muted);margin-left:4px;"></i>
      </div>
      <ul class="dropdown-menu dropdown-menu-end">
        <li>
          <a class="dropdown-item" href="/profile">
            <i class="fa-solid fa-circle-user"></i> My Profile
          </a>
        </li>
        <li>
          <a class="dropdown-item" href="/settings">
            <i class="fa-solid fa-sliders"></i> Settings
          </a>
        </li>
        <li>
          <a class="dropdown-item" href="/auth/change-password">
            <i class="fa-solid fa-key"></i> Change Password
          </a>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <a class="dropdown-item text-danger" href="/auth/logout">
            <i class="fa-solid fa-right-from-bracket"></i> Sign Out
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>
