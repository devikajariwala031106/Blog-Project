<nav class="breadcrumb-wrapper" aria-label="breadcrumb">
  <a href="/dashboard" class="breadcrumb-item">
    <i class="fa-solid fa-house" style="font-size:11px;"></i>
  </a>
  <span class="breadcrumb-separator"><i class="fa-solid fa-chevron-right" style="font-size:9px;"></i></span>
  <% if (typeof breadcrumbs !== 'undefined') { %>
    <% breadcrumbs.forEach((crumb, i) => { %>
      <% if (i < breadcrumbs.length - 1) { %>
        <a href="<%= crumb.url %>" class="breadcrumb-item"><%= crumb.label %></a>
        <span class="breadcrumb-separator"><i class="fa-solid fa-chevron-right" style="font-size:9px;"></i></span>
      <% } else { %>
        <span class="breadcrumb-item active"><%= crumb.label %></span>
      <% } %>
    <% }) %>
  <% } else { %>
    <span class="breadcrumb-item active"><%= typeof title !== 'undefined' ? title : 'Page' %></span>
  <% } %>
</nav>
