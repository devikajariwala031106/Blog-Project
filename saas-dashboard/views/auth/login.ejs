<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-logo">
      <div class="auth-logo-icon">
        <i class="fa-solid fa-bolt"></i>
      </div>
      <div class="auth-brand">SaaS<span>Hub</span></div>
    </div>

    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-subtitle">Sign in to your dashboard to continue</p>

    <form action="/auth/login" method="POST" class="auth-form">
      <div class="form-group">
        <label class="form-label-custom" for="email">
          <i class="fa-regular fa-envelope" style="margin-right:6px;"></i>Email Address
        </label>
        <div class="input-with-icon">
          <i class="input-icon fa-regular fa-envelope"></i>
          <input
            type="email"
            id="email"
            name="email"
            class="form-control-custom"
            placeholder="you@example.com"
            required
            autocomplete="email"
          >
        </div>
      </div>

      <div class="form-group">
        <label class="form-label-custom" for="password">
          <i class="fa-solid fa-lock" style="margin-right:6px;"></i>Password
        </label>
        <div class="input-with-icon">
          <i class="input-icon fa-solid fa-lock"></i>
          <input
            type="password"
            id="password"
            name="password"
            class="form-control-custom"
            placeholder="Enter your password"
            required
            autocomplete="current-password"
          >
          <i class="fa-regular fa-eye toggle-password" style="cursor:pointer;position:absolute;right:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);"></i>
        </div>
      </div>

      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
        <label class="toggle-switch">
          <input type="checkbox" id="rememberMe">
          <span class="toggle-track"></span>
          <span class="toggle-label">Remember me</span>
        </label>
        <a href="/auth/forgot-password" style="font-size:13px;color:var(--accent-light);font-weight:500;">
          Forgot password?
        </a>
      </div>

      <button type="submit" class="btn-auth" id="loginBtn">
        <i class="fa-solid fa-arrow-right-to-bracket" style="margin-right:8px;"></i>
        Sign In to Dashboard
      </button>
    </form>

    <div style="margin-top:24px;text-align:center;">
      <p style="font-size:12px;color:var(--text-muted);">
        <i class="fa-solid fa-shield-halved" style="color:var(--accent);margin-right:6px;"></i>
        Your data is protected with enterprise-grade encryption
      </p>
    </div>
  </div>
</div>
