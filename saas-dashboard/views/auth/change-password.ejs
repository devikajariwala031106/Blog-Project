<%- include('../partials/breadcrumb') %>

<div class="page-header">
  <div>
    <h1 class="page-title">
      <i class="fa-solid fa-key" style="color:var(--accent);margin-right:10px;"></i>Change Password
    </h1>
    <p class="page-subtitle">Update your account password for enhanced security</p>
  </div>
</div>

<div class="form-section">
  <div class="form-card">
    <form action="/auth/change-password" method="POST">
      <div class="form-group">
        <label class="form-label-custom" for="currentPassword">
          <i class="fa-solid fa-lock" style="margin-right:6px;"></i>Current Password
        </label>
        <div class="input-with-icon">
          <i class="input-icon fa-solid fa-lock"></i>
          <input type="password" id="currentPassword" name="currentPassword" class="form-control-custom" placeholder="Enter current password" required>
          <i class="fa-regular fa-eye toggle-password" style="cursor:pointer;position:absolute;right:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);"></i>
        </div>
      </div>

      <div class="form-divider"></div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label-custom" for="newPassword">
            <i class="fa-solid fa-lock-open" style="margin-right:6px;"></i>New Password
          </label>
          <div class="input-with-icon">
            <i class="input-icon fa-solid fa-lock-open"></i>
            <input type="password" id="newPassword" name="newPassword" class="form-control-custom" placeholder="Minimum 6 characters" required minlength="6">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label-custom" for="confirmPassword">
            <i class="fa-solid fa-check-double" style="margin-right:6px;"></i>Confirm New Password
          </label>
          <div class="input-with-icon">
            <i class="input-icon fa-solid fa-check-double"></i>
            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control-custom" placeholder="Repeat new password" required>
          </div>
        </div>
      </div>

      <div style="background:rgba(245,158,11,0.07);border:1px solid rgba(245,158,11,0.2);border-radius:10px;padding:14px 16px;margin-bottom:24px;display:flex;align-items:flex-start;gap:10px;">
        <i class="fa-solid fa-triangle-exclamation" style="color:var(--warning);margin-top:2px;"></i>
        <div>
          <div style="font-size:13px;font-weight:600;color:var(--warning);margin-bottom:3px;">Password Requirements</div>
          <div style="font-size:12px;color:var(--text-muted);">Must be at least 6 characters long. Use a mix of letters, numbers, and symbols for a stronger password.</div>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-primary-custom">
          <i class="fa-solid fa-floppy-disk"></i> Update Password
        </button>
        <a href="/dashboard" class="btn-secondary-custom">
          <i class="fa-solid fa-xmark"></i> Cancel
        </a>
      </div>
    </form>
  </div>
</div>
