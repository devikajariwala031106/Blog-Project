<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="SaaS Dashboard Authentication">
  <title><%= typeof title !== 'undefined' ? title : 'SaaS Dashboard' %></title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%236366f1'/><text y='.9em' font-size='80' x='10'>S</text></svg>">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="auth-bg-grid"></div>
<div class="auth-bg-glow glow-1"></div>
<div class="auth-bg-glow glow-2"></div>

<% if (typeof success !== 'undefined' && success.length > 0) { %>
<div class="flash-container">
  <% success.forEach(msg => { %>
  <div class="flash-alert flash-success">
    <i class="fa-solid fa-circle-check"></i>
    <%= msg %>
    <button class="flash-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
  <% }) %>
</div>
<% } %>

<% if (typeof error !== 'undefined' && error.length > 0) { %>
<div class="flash-container">
  <% error.forEach(msg => { %>
  <div class="flash-alert flash-error">
    <i class="fa-solid fa-circle-exclamation"></i>
    <%= msg %>
    <button class="flash-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
  <% }) %>
</div>
<% } %>

<% if (typeof info !== 'undefined' && info.length > 0) { %>
<div class="flash-container">
  <% info.forEach(msg => { %>
  <div class="flash-alert flash-info">
    <i class="fa-solid fa-circle-info"></i>
    <%= msg %>
    <button class="flash-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
  <% }) %>
</div>
<% } %>

<%- body %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
