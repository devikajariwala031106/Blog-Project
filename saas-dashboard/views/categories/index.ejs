<%- include('../partials/breadcrumb') %>

<div class="page-header">
  <div>
    <h1 class="page-title">
      <i class="fa-solid fa-layer-group" style="color:var(--accent);margin-right:10px;"></i>Category Management
    </h1>
    <p class="page-subtitle">Organize your products with structured categories</p>
  </div>
  <a href="/categories/add" class="btn-primary-custom">
    <i class="fa-solid fa-plus"></i> Add Category
  </a>
</div>

<div class="card">
  <div style="padding:20px 24px;border-bottom:1px solid var(--glass-border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
    <div class="section-title">
      <i class="fa-solid fa-list"></i>
      All Categories
      <span style="font-size:12px;font-weight:400;color:var(--text-muted);margin-left:8px;">(<%= categories.length %> total)</span>
    </div>
    <form action="/categories" method="GET" class="d-flex gap-2">
      <div class="search-box">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" name="search" value="<%= search %>" placeholder="Search categories...">
      </div>
      <button type="submit" class="btn-primary-custom" style="padding:9px 16px;">
        <i class="fa-solid fa-magnifying-glass"></i>
      </button>
      <% if (search) { %>
      <a href="/categories" class="btn-secondary-custom" style="padding:9px 14px;"><i class="fa-solid fa-xmark"></i></a>
      <% } %>
    </form>
  </div>

  <% if (categories && categories.length > 0) { %>
  <div style="overflow-x:auto;">
    <table class="custom-table">
      <thead>
        <tr>
          <th>#</th>
          <th><i class="fa-solid fa-layer-group" style="margin-right:6px;"></i>Name</th>
          <th><i class="fa-solid fa-link" style="margin-right:6px;"></i>Slug</th>
          <th><i class="fa-solid fa-align-left" style="margin-right:6px;"></i>Description</th>
          <th><i class="fa-solid fa-circle-half-stroke" style="margin-right:6px;"></i>Status</th>
          <th><i class="fa-regular fa-calendar" style="margin-right:6px;"></i>Created</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% categories.forEach((cat, i) => { %>
        <tr>
          <td style="color:var(--text-muted);font-size:12px;"><%= i + 1 %></td>
          <td>
            <div style="display:flex;align-items:center;gap:10px;">
              <div style="width:34px;height:34px;background:rgba(6,182,212,0.1);color:var(--info);border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:14px;">
                <i class="fa-solid fa-layer-group"></i>
              </div>
              <span style="font-weight:600;color:var(--text-primary)"><%= cat.name %></span>
            </div>
          </td>
          <td>
            <code style="font-size:11px;background:rgba(255,255,255,0.05);padding:3px 8px;border-radius:6px;color:var(--accent-light);">
              <%= cat.slug || '—' %>
            </code>
          </td>
          <td style="color:var(--text-muted);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
            <%= cat.description || '<span style="font-style:italic;">No description</span>' %>
          </td>
          <td>
            <span class="badge-custom badge-<%= cat.status %>">
              <i class="fa-solid fa-circle" style="font-size:6px;margin-right:5px;"></i>
              <%= cat.status.charAt(0).toUpperCase() + cat.status.slice(1) %>
            </span>
          </td>
          <td style="color:var(--text-muted);font-size:12px;">
            <%= cat.createdAt ? cat.createdAt.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' }) : '—' %>
          </td>
          <td>
            <div class="action-btns">
              <a href="/categories/<%= cat._id %>/edit" class="btn-icon btn-edit" title="Edit category">
                <i class="fa-solid fa-pen-to-square"></i>
              </a>
              <button class="btn-icon btn-delete"
                data-delete-url="/categories/<%= cat._id %>?_method=DELETE"
                data-delete-name="<%= cat.name %>"
                title="Delete category">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div class="empty-state">
    <div class="empty-icon"><i class="fa-solid fa-layer-group"></i></div>
    <div class="empty-title"><%= search ? 'No categories found' : 'No categories yet' %></div>
    <div class="empty-desc"><%= search ? `No results for "${search}"` : 'Create your first category to organize products.' %></div>
    <% if (!search) { %>
    <a href="/categories/add" class="btn-primary-custom"><i class="fa-solid fa-plus"></i> Add Category</a>
    <% } %>
  </div>
  <% } %>
</div>
