<%- include('../partials/breadcrumb', { breadcrumbs: [{ label: 'Categories', url: '/categories' }, { label: 'Edit Category', url: '#' }] }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">
      <i class="fa-solid fa-folder-open" style="color:var(--accent);margin-right:10px;"></i>Edit Category
    </h1>
    <p class="page-subtitle">Update details for <strong style="color:var(--accent-light);"><%= category.name %></strong></p>
  </div>
  <a href="/categories" class="btn-secondary-custom"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div class="form-section">
  <div class="form-card">
    <form action="/categories/<%= category._id %>/edit" method="POST">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label-custom" for="name">
            <i class="fa-solid fa-layer-group" style="margin-right:6px;"></i>Category Name
          </label>
          <input type="text" id="name" name="name" class="form-control-custom" value="<%= category.name %>" required>
        </div>
        <div class="form-group">
          <label class="form-label-custom" for="status">
            <i class="fa-solid fa-circle-half-stroke" style="margin-right:6px;"></i>Status
          </label>
          <select id="status" name="status" class="form-control-custom">
            <option value="active" <%= category.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= category.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label-custom" for="description">
          <i class="fa-solid fa-align-left" style="margin-right:6px;"></i>Description
        </label>
        <textarea id="description" name="description" class="form-control-custom" rows="4"><%= category.description || '' %></textarea>
      </div>

      <div class="form-divider"></div>

      <div class="form-actions">
        <button type="submit" class="btn-primary-custom"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
        <a href="/categories" class="btn-secondary-custom"><i class="fa-solid fa-xmark"></i> Cancel</a>
        <button type="button" class="btn-danger-custom ms-auto"
          data-delete-url="/categories/<%= category._id %>?_method=DELETE"
          data-delete-name="<%= category.name %>">
          <i class="fa-solid fa-trash"></i> Delete
        </button>
      </div>
    </form>
  </div>
</div>
