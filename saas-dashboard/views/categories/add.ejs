<%- include('../partials/breadcrumb', { breadcrumbs: [{ label: 'Categories', url: '/categories' }, { label: 'Add Category', url: '#' }] }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">
      <i class="fa-solid fa-folder-plus" style="color:var(--accent);margin-right:10px;"></i>Add Category
    </h1>
    <p class="page-subtitle">Create a new category to organize products</p>
  </div>
  <a href="/categories" class="btn-secondary-custom"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div class="form-section">
  <div class="form-card">
    <form action="/categories/add" method="POST">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:28px;padding-bottom:20px;border-bottom:1px solid var(--glass-border);">
        <div style="width:48px;height:48px;background:rgba(6,182,212,0.15);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--info);">
          <i class="fa-solid fa-layer-group"></i>
        </div>
        <div>
          <div style="font-size:15px;font-weight:700;color:var(--text-primary);">Category Details</div>
          <div style="font-size:13px;color:var(--text-muted);">The slug will be auto-generated from the name</div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label-custom" for="name">
            <i class="fa-solid fa-layer-group" style="margin-right:6px;"></i>Category Name
          </label>
          <input type="text" id="name" name="name" class="form-control-custom" placeholder="e.g. Electronics" required>
        </div>
        <div class="form-group">
          <label class="form-label-custom" for="status">
            <i class="fa-solid fa-circle-half-stroke" style="margin-right:6px;"></i>Status
          </label>
          <select id="status" name="status" class="form-control-custom">
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label-custom" for="description">
          <i class="fa-solid fa-align-left" style="margin-right:6px;"></i>Description
        </label>
        <textarea id="description" name="description" class="form-control-custom" rows="4" placeholder="Describe this category..."></textarea>
      </div>

      <div class="form-divider"></div>

      <div class="form-actions">
        <button type="submit" class="btn-primary-custom"><i class="fa-solid fa-plus"></i> Create Category</button>
        <a href="/categories" class="btn-secondary-custom"><i class="fa-solid fa-xmark"></i> Cancel</a>
      </div>
    </form>
  </div>
</div>
